# Example only: replace with the intended environment. No credentials are included.
FL_SERVER_MANAGER_URL=http://127.0.0.1:8000
# SERVER_MANAGER_URL is a compatible alias; set at most one or use matching values.
EMAIL_VERIFICATION_BASE_URL=http://127.0.0.1:8080
RUNTIME_ARTIFACT_BASE_URL=http://127.0.0.1:4000/fedops/api/task-releases/runtime-artifacts
REGISTRY_API_BASE_URL=http://127.0.0.1:8012
REGISTRY_API_TIMEOUT_MS=30000
FL_SERVER_MANAGER_PUBLIC_URL=http://127.0.0.1:8000
FL_AGGREGATION_PUBLIC_HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:3000
PORT=4000
# Inject fresh secret values separately; empty entries intentionally prevent full startup.
MONGO_URI=
JWT_SECRET=
# RUNTIME_ARTIFACT_SECRET may use the existing JWT_SECRET fallback contract.
RUNTIME_ARTIFACT_SECRET=
BUCKET_NAME=global-model
XAI_BUCKET_NAME=global-model-xai
REGION_NAME=ap-northeast-2
ACCESS_KEY_ID=
ACCESS_SECRET_KEY=
# MinIO examples: replace these addresses; inject MinIO credentials above separately.
# XAI uses the same endpoint with XAI_BUCKET_NAME, like other stored files.
S3_ENDPOINT_URL=http://minio.example.invalid:9000
S3_PUBLIC_ENDPOINT_URL=https://objects.example.invalid
# Defaults to true when an endpoint is supplied. Explicit false remains supported.
S3_FORCE_PATH_STYLE=true
# DOTENV_CONFIG_PATH must be set in the launching process to select another file.
